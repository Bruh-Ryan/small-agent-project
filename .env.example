OPENROUTER_API_KEY=
MONGODB_URI=mongodb://localhost:27017/wiki-agent
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string

# Optional extra LLM providers (Phase 7). A provider only appears in the
# model picker when its key is set here. All are OpenAI-compatible.
GROQ_API_KEY=          # console.groq.com/keys        — free tier
GEMINI_API_KEY=        # aistudio.google.com/apikey   — free Flash tier
MISTRAL_API_KEY=       # console.mistral.ai           — free Experiment tier
HF_TOKEN=              # huggingface.co/settings/tokens — Inference Providers (~$0.10/mo free)

# Default model. Leave blank to use the first enabled catalog entry.
# Prefix with the provider name, or leave it bare for OpenRouter:
#   MODEL=groq:openai/gpt-oss-120b
#   MODEL=qwen/qwen3.8-27b:free
MODEL=

# TEST/DEMO ONLY — force providers to fail so the fallback chain and the
# "all providers unavailable" message can be verified without waiting for a
# real quota to run out. Comma-separated provider names (groq, openrouter,
# mistral), full model ids (groq:openai/gpt-oss-120b), or "all".
# Leave unset in normal use. Read per request, so no restart is needed after
# changing it in a running process's environment.
#   FORCE_FAIL_PROVIDERS=groq,openrouter
#   FORCE_FAIL_PROVIDERS=all
FORCE_FAIL_PROVIDERS=

